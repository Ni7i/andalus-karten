<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Andalusische Palette: Petrol, Sand, Terrakotta -->
    <Color x:Key="Teal">#0F5257</Color>
    <Color x:Key="TealLight">#5FB3B3</Color>
    <Color x:Key="Sand">#F6F0E4</Color>
    <Color x:Key="SandDark">#E9DCC4</Color>
    <Color x:Key="Terracotta">#C0583A</Color>
    <Color x:Key="Olive">#4E7D3A</Color>
    <Color x:Key="Ink">#1F2A2B</Color>
    <Color x:Key="InkMuted">#5C6A6B</Color>
    <Color x:Key="Night">#121A1B</Color>
    <Color x:Key="NightCard">#1C2627</Color>
    <Color x:Key="NightLine">#2C3A3B</Color>
    <Color x:Key="Moon">#ECE6DA</Color>
    <Color x:Key="MoonMuted">#9DAAAA</Color>

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Sand}, Dark={StaticResource Night}}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource Teal}, Dark={StaticResource NightCard}}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource Sand}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource Sand}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light=White, Dark={StaticResource NightCard}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Light={StaticResource Teal}, Dark={StaticResource TealLight}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource Teal}, Dark={StaticResource TealLight}}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource MoonMuted}}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Moon}}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="Heading" TargetType="Label">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Teal}, Dark={StaticResource Moon}}" />
    </Style>

    <Style x:Key="Muted" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource MoonMuted}}" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="Label" BasedOn="{StaticResource Muted}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1" />
        <Setter Property="Margin" Value="4,16,0,6" />
    </Style>

    <Style x:Key="ArabicText" TargetType="Label">
        <Setter Property="FlowDirection" Value="RightToLeft" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Moon}}" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark={StaticResource NightCard}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource SandDark}, Dark={StaticResource NightLine}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Teal}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Teal}, Dark={StaticResource TealLight}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Teal}, Dark={StaticResource TealLight}}" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="TextColor" Value="{StaticResource Terracotta}" />
        <Setter Property="BorderColor" Value="{StaticResource Terracotta}" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{AppThemeBinding Light={StaticResource Teal}, Dark={StaticResource TealLight}}" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{StaticResource TealLight}" />
        <Setter Property="ThumbColor" Value="{StaticResource Teal}" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Moon}}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource MoonMuted}}" />
    </Style>
</ResourceDictionary>
