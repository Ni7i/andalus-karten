<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AndalusKarten.ViewModels"
             x:Class="AndalusKarten.Views.FlashcardsPage"
             x:DataType="vm:FlashcardsViewModel"
             Title="{Binding CounterText}">

    <Grid Padding="16,8,16,16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14" MaximumWidthRequest="760">

        <ProgressBar Progress="{Binding ProgressValue}" HeightRequest="4" IsVisible="{Binding IsStudying}" />

        <!-- Zähler links (lerne ich noch) und rechts (gewusst) -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsStudying}">
            <Border Style="{StaticResource Pill}" BackgroundColor="{DynamicResource LearningSoft}"
                    Stroke="{DynamicResource Learning}" StrokeThickness="1.5">
                <Label Text="{Binding LearningCount}" TextColor="{DynamicResource Learning}" FontAttributes="Bold" />
            </Border>
            <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Muted}"
                   HorizontalTextAlignment="Center" VerticalOptions="Center" LineBreakMode="TailTruncation" />
            <Border Grid.Column="2" Style="{StaticResource Pill}" BackgroundColor="{DynamicResource KnownSoft}"
                    Stroke="{DynamicResource Known}" StrokeThickness="1.5">
                <Label Text="{Binding KnownCount}" TextColor="{DynamicResource Known}" FontAttributes="Bold" />
            </Border>
        </Grid>

        <!-- Karte -->
        <Grid Grid.Row="2" IsVisible="{Binding IsStudying}">
            <Border x:Name="Card" Style="{StaticResource Card}" Padding="28" StrokeShape="RoundRectangle 18">
                <Border.Shadow>
                    <Shadow Brush="#1A2340" Offset="0,6" Radius="22" Opacity="0.16" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCardTapped" />
                    <PanGestureRecognizer PanUpdated="OnCardPanned" />
                </Border.GestureRecognizers>
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding FaceLabel}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding StarGlyph}" FontSize="26" TextColor="{DynamicResource Gold}"
                               Padding="8,0,0,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleStarCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" Spacing="16">
                        <Label Text="{Binding FaceText}" FontSize="{Binding FaceFontSize}" FlowDirection="{Binding FaceFlow}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="{Binding FaceHint}" IsVisible="{Binding HasHint}" Style="{StaticResource Muted}"
                               FontSize="17" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <Label Grid.Row="2" Text="Tippen zum Umdrehen · Wischen zum Bewerten" Style="{StaticResource Muted}"
                           FontSize="12" HorizontalTextAlignment="Center" />
                </Grid>
            </Border>

            <!-- Farbiger Rahmen + Text während des Wischens -->
            <Border x:Name="SwipeOverlay" InputTransparent="True" Opacity="0" StrokeThickness="4"
                    StrokeShape="RoundRectangle 18" BackgroundColor="Transparent">
                <Label x:Name="SwipeLabel" FontSize="26" FontAttributes="Bold"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- Steuerleiste -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto,*,Auto" ColumnSpacing="12" IsVisible="{Binding IsStudying}">
            <Button Text="↶" Style="{StaticResource Round}" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" />
            <Button Grid.Column="2" Text="✕" Style="{StaticResource Round}" TextColor="{DynamicResource Learning}"
                    BorderColor="{DynamicResource Learning}" Clicked="OnLearningClicked" />
            <Button Grid.Column="3" Text="✓" Style="{StaticResource Round}" TextColor="{DynamicResource Known}"
                    BorderColor="{DynamicResource Known}" Clicked="OnKnownClicked" />
            <Button Grid.Column="5" Text="{Binding ShuffleText}" Style="{StaticResource Ghost}" FontSize="13"
                    Padding="12,0" HeightRequest="56" Command="{Binding ToggleShuffleCommand}" />
        </Grid>

        <!-- Ergebnis -->
        <ScrollView Grid.RowSpan="4" IsVisible="{Binding IsFinished}">
            <VerticalStackLayout Spacing="18" Padding="0,24" VerticalOptions="Center">
                <Label Text="{Binding ResultTitle}" Style="{StaticResource Title}" HorizontalTextAlignment="Center" />
                <Border Style="{StaticResource Card}" Padding="24">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="24">
                        <Grid WidthRequest="120" HeightRequest="120">
                            <GraphicsView x:Name="Donut" />
                            <Label Text="{Binding ResultPercent}" FontSize="26" FontAttributes="Bold"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                        <VerticalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Gewusst" TextColor="{DynamicResource Known}" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding KnownCount}" TextColor="{DynamicResource Known}" FontAttributes="Bold" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Lerne ich noch" TextColor="{DynamicResource Learning}" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding LearningCount}" TextColor="{DynamicResource Learning}" FontAttributes="Bold" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
                <Button Text="{Binding ContinueText}" Command="{Binding ContinueLearningCommand}" IsVisible="{Binding HasStillLearning}" />
                <Button Text="Karteikarten zurücksetzen" Style="{StaticResource Ghost}" Command="{Binding RestartCommand}" />
                <Button Text="Fertig" Style="{StaticResource Ghost}" Command="{Binding CloseCommand}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
