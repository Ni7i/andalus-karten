<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AndalusKarten.ViewModels"
             x:Class="AndalusKarten.Views.LessonPage"
             x:DataType="vm:LessonViewModel"
             Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Zurücksetzen" Order="Secondary" Command="{Binding ResetCommand}" />
    </ContentPage.ToolbarItems>

    <CollectionView ItemsSource="{Binding Words}" SelectionMode="None" MaximumWidthRequest="760">
        <CollectionView.Header>
            <VerticalStackLayout Padding="16" Spacing="12">
                <Label Text="{Binding Summary}" Style="{StaticResource Muted}" />
                <ProgressBar Progress="{Binding Progress}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Text="Alle lernen" Command="{Binding StudyAllCommand}" />
                    <Button Grid.Column="1" Text="{Binding WeakButtonText}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding StudyWeakCommand}" IsEnabled="{Binding HasWeak}" />
                </Grid>
                <Label Text="WÖRTER" Style="{StaticResource SectionTitle}" />
            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:WordRow">
                <Border Style="{StaticResource Card}" Margin="16,4" Padding="14,10">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12">
                        <Label Text="{Binding German}" FontSize="16" VerticalOptions="Center" />
                        <Label Grid.Row="1" Text="{Binding Transliteration}" IsVisible="{Binding HasTransliteration}"
                               Style="{StaticResource Muted}" FontAttributes="Italic" />
                        <Label Grid.Row="2" Text="{Binding Level}" FontSize="11"
                               TextColor="{AppThemeBinding Light={StaticResource TealLight}, Dark={StaticResource TealLight}}" />
                        <Label Grid.Column="1" Grid.RowSpan="3" Text="{Binding Arabic}"
                               Style="{StaticResource ArabicText}" VerticalOptions="Center" />
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.Footer>
            <BoxView HeightRequest="16" Color="Transparent" />
        </CollectionView.Footer>
    </CollectionView>
</ContentPage>
