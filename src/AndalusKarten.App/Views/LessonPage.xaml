<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AndalusKarten.ViewModels"
             x:Class="AndalusKarten.Views.LessonPage"
             x:DataType="vm:LessonViewModel"
             Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Fortschritt zurücksetzen" Order="Secondary" Command="{Binding ResetCommand}" />
    </ContentPage.ToolbarItems>

    <CollectionView ItemsSource="{Binding Words}" SelectionMode="None" MaximumWidthRequest="820">
        <CollectionView.Header>
            <VerticalStackLayout Padding="16,8,16,0" Spacing="16">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding Title}" Style="{StaticResource Title}" />
                    <Label Text="{Binding Subtitle}" Style="{StaticResource Muted}" LineBreakMode="TailTruncation" />
                </VerticalStackLayout>

                <!-- Vorschaukarte -->
                <Border x:Name="Preview" Style="{StaticResource Card}" HeightRequest="230" Padding="20">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPreviewTapped" />
                        <SwipeGestureRecognizer Direction="Left" Command="{Binding NextPreviewCommand}" />
                        <SwipeGestureRecognizer Direction="Right" Command="{Binding PreviousPreviewCommand}" />
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="*,Auto">
                        <Label Text="{Binding PreviewText}" FontSize="{Binding PreviewFontSize}" FlowDirection="{Binding PreviewFlow}"
                               HorizontalTextAlignment="Center" VerticalOptions="Center" />
                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
                            <Button Text="‹" Style="{StaticResource Round}" WidthRequest="44" HeightRequest="44" CornerRadius="22"
                                    Command="{Binding PreviousPreviewCommand}" />
                            <Label Grid.Column="1" Text="{Binding PreviewCounter}" Style="{StaticResource Muted}"
                                   HorizontalTextAlignment="Center" VerticalOptions="Center" />
                            <Button Grid.Column="2" Text="›" Style="{StaticResource Round}" WidthRequest="44" HeightRequest="44" CornerRadius="22"
                                    Command="{Binding NextPreviewCommand}" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Lernmodi -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Border Style="{StaticResource Card}" Padding="12,16">
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding FlashcardsCommand}" /></Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="▤" FontSize="26" TextColor="{DynamicResource Accent}" HorizontalOptions="Center" />
                            <Label Text="Karteikarten" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12,16">
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding LearnCommand}" /></Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="◎" FontSize="26" TextColor="{DynamicResource Accent}" HorizontalOptions="Center" />
                            <Label Text="Lernen" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,16">
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding MatchCommand}" /></Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="⇄" FontSize="26" TextColor="{DynamicResource Accent}" HorizontalOptions="Center" />
                            <Label Text="Zuordnen" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Button Text="{Binding DueText}" IsVisible="{Binding HasDue}" Command="{Binding ReviewDueCommand}"
                        BackgroundColor="{DynamicResource Learning}" />

                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasStarred}">
                    <Label Text="{Binding StarredText}" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding OnlyStarred}" />
                </Grid>

                <!-- Fortschritt -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Border Style="{StaticResource Card}" Padding="10" BackgroundColor="{DynamicResource SurfaceAlt}">
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="{Binding NewCount}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label Text="Neu" Style="{StaticResource Muted}" FontSize="12" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="10" BackgroundColor="{DynamicResource LearningSoft}">
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="{Binding LearningCount}" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource Learning}" HorizontalOptions="Center" />
                            <Label Text="Am Lernen" Style="{StaticResource Muted}" FontSize="12" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10" BackgroundColor="{DynamicResource KnownSoft}">
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="{Binding KnownCount}" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource Known}" HorizontalOptions="Center" />
                            <Label Text="Gemeistert" Style="{StaticResource Muted}" FontSize="12" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Label Text="BEGRIFFE IN DIESER LEKTION" Style="{StaticResource Caption}" Margin="0,8,0,0" />
            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:WordRow">
                <Border Style="{StaticResource Card}" Margin="16,5" Padding="14,12">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                            <Label Text="{Binding German}" FontSize="16" />
                            <Label Text="{Binding Detail}" IsVisible="{Binding HasDetail}" Style="{StaticResource Muted}" FontSize="13" />
                            <Label Text="{Binding Status}" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource Muted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding Arabic}" Style="{StaticResource Arabic}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="{Binding StarGlyph}" FontSize="24" TextColor="{DynamicResource Gold}"
                               VerticalOptions="Center" Padding="6,0,0,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleStarCommand, Source={RelativeSource AncestorType={x:Type vm:LessonViewModel}}, x:DataType=vm:LessonViewModel}"
                                                      CommandParameter="{Binding .}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.Footer>
            <BoxView HeightRequest="24" Color="Transparent" />
        </CollectionView.Footer>
    </CollectionView>
</ContentPage>
