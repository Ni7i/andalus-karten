<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AndalusKarten.ViewModels"
             x:Class="AndalusKarten.Views.StudyPage"
             x:DataType="vm:StudyViewModel"
             Title="{Binding Title}">

    <Grid Padding="16" RowDefinitions="Auto,*,Auto" RowSpacing="16" MaximumWidthRequest="640">

        <!-- Fortschritt -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding IsStudying}">
            <ProgressBar Progress="{Binding ProgressValue}" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="{Binding ProgressText}" Style="{StaticResource Muted}" />
        </Grid>

        <!-- Karte -->
        <Border x:Name="Card" Grid.Row="1" Style="{StaticResource Card}" Padding="24"
                IsVisible="{Binding IsStudying}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCardTapped" />
            </Border.GestureRecognizers>
            <Grid RowDefinitions="*,Auto,*" RowSpacing="18">
                <Label Grid.Row="0" Text="{Binding Question}"
                       FontSize="{Binding QuestionFontSize}" FlowDirection="{Binding QuestionFlow}"
                       HorizontalTextAlignment="Center" VerticalOptions="End"
                       TextColor="{AppThemeBinding Light={StaticResource Teal}, Dark={StaticResource Moon}}" />

                <BoxView Grid.Row="1" HeightRequest="1" Margin="40,0" IsVisible="{Binding IsRevealed}"
                         Color="{AppThemeBinding Light={StaticResource SandDark}, Dark={StaticResource NightLine}}" />

                <VerticalStackLayout Grid.Row="2" Spacing="10" VerticalOptions="Start" IsVisible="{Binding IsRevealed}">
                    <Label Text="{Binding Answer}"
                           FontSize="{Binding AnswerFontSize}" FlowDirection="{Binding AnswerFlow}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding Hint}" IsVisible="{Binding HasHint}"
                           Style="{StaticResource Muted}" FontAttributes="Italic" FontSize="17"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding Note}" IsVisible="{Binding HasNote}"
                           Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Label Grid.Row="2" Text="Tippen zum Aufdecken" IsVisible="{Binding IsHidden}"
                       Style="{StaticResource Muted}" HorizontalTextAlignment="Center" VerticalOptions="End" />
            </Grid>
        </Border>

        <!-- Bewertung -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding IsStudying}">
            <Button Text="Aufdecken" Grid.ColumnSpan="2" Command="{Binding RevealCommand}"
                    IsVisible="{Binding IsHidden}" />
            <Button Text="Nochmal" Command="{Binding AgainCommand}" IsVisible="{Binding IsRevealed}"
                    BackgroundColor="{StaticResource Terracotta}" />
            <Button Grid.Column="1" Text="Gewusst" Command="{Binding KnewCommand}" IsVisible="{Binding IsRevealed}"
                    BackgroundColor="{StaticResource Olive}" />
        </Grid>

        <!-- Ergebnis -->
        <VerticalStackLayout Grid.RowSpan="3" Spacing="14" VerticalOptions="Center" IsVisible="{Binding IsFinished}">
            <Label Text="Runde geschafft" Style="{StaticResource Heading}" HorizontalTextAlignment="Center" />
            <Label Text="{Binding ResultText}" HorizontalTextAlignment="Center" />
            <Button Text="Schwierige nochmal üben" Command="{Binding RepeatMissedCommand}"
                    IsVisible="{Binding HasMissed}" BackgroundColor="{StaticResource Terracotta}" />
            <Button Text="Alle nochmal" Command="{Binding RepeatAllCommand}" Style="{StaticResource SecondaryButton}" />
            <Button Text="Fertig" Command="{Binding CloseCommand}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
