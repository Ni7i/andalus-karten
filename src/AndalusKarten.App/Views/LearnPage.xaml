<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AndalusKarten.ViewModels"
             x:Class="AndalusKarten.Views.LearnPage"
             x:DataType="vm:LearnViewModel"
             Title="Lernen">

    <Grid Padding="16,8,16,16" RowDefinitions="Auto,*,Auto" RowSpacing="16" MaximumWidthRequest="760">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding IsStudying}">
            <ProgressBar Progress="{Binding ProgressValue}" ProgressColor="{DynamicResource Known}" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="{Binding ProgressText}" Style="{StaticResource Muted}" />
        </Grid>

        <ScrollView Grid.Row="1" IsVisible="{Binding IsStudying}">
            <VerticalStackLayout Spacing="16">
                <Border Style="{StaticResource Card}" Padding="24" MinimumHeightRequest="200">
                    <Grid RowDefinitions="Auto,*">
                        <Label Text="{Binding PromptLabel}" Style="{StaticResource Caption}" />
                        <Label Grid.Row="1" Text="{Binding Prompt}" FontSize="{Binding PromptFontSize}"
                               FlowDirection="{Binding PromptFlow}" HorizontalTextAlignment="Center"
                               VerticalOptions="Center" Margin="0,16" />
                    </Grid>
                </Border>

                <Label Text="Wähle die richtige Antwort" Style="{StaticResource Caption}" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Options}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChoiceOption">
                            <Border Style="{StaticResource Card}" Padding="14" Stroke="{DynamicResource Line}" StrokeThickness="2">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ChooseCommand, Source={RelativeSource AncestorType={x:Type vm:LearnViewModel}}, x:DataType=vm:LearnViewModel}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding State}" Value="{x:Static vm:OptionState.Correct}">
                                        <Setter Property="Stroke" Value="{DynamicResource Known}" />
                                        <Setter Property="BackgroundColor" Value="{DynamicResource KnownSoft}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding State}" Value="{x:Static vm:OptionState.Wrong}">
                                        <Setter Property="Stroke" Value="{DynamicResource Wrong}" />
                                        <Setter Property="BackgroundColor" Value="{DynamicResource LearningSoft}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding State}" Value="{x:Static vm:OptionState.Dimmed}">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Grid ColumnDefinitions="32,*" ColumnSpacing="12">
                                    <Border WidthRequest="28" HeightRequest="28" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                            BackgroundColor="{DynamicResource SurfaceAlt}" VerticalOptions="Center">
                                        <Label Text="{Binding Number}" FontSize="13" FontAttributes="Bold"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding Text}" FontSize="{Binding FontSize}"
                                           FlowDirection="{Binding Flow}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Rückmeldung -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding IsAnswered}">
            <Label Text="{Binding Feedback}" FontAttributes="Bold" FontSize="18" VerticalOptions="Center">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding WasCorrect}" Value="True">
                        <Setter Property="TextColor" Value="{DynamicResource Known}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Label" Binding="{Binding WasCorrect}" Value="False">
                        <Setter Property="TextColor" Value="{DynamicResource Learning}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <Button Grid.Column="1" Text="Weiter" Command="{Binding NextCommand}" />
        </Grid>

        <VerticalStackLayout Grid.RowSpan="3" Spacing="16" VerticalOptions="Center" IsVisible="{Binding IsFinished}">
            <Label Text="Runde geschafft!" Style="{StaticResource Title}" HorizontalTextAlignment="Center" />
            <Label Text="{Binding ResultText}" HorizontalTextAlignment="Center" Style="{StaticResource Muted}" FontSize="16" />
            <Button Text="Nochmal lernen" Command="{Binding StartCommand}" />
            <Button Text="Fertig" Style="{StaticResource Ghost}" Command="{Binding CloseCommand}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
