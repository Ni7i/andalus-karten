<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AndalusKarten.ViewModels"
             x:Class="AndalusKarten.Views.LessonListPage"
             x:DataType="vm:LessonsViewModel">

    <CollectionView ItemsSource="{Binding Lessons}" SelectionMode="None" MaximumWidthRequest="820">
        <CollectionView.Header>
            <VerticalStackLayout Padding="16,8,16,8" Spacing="14">
                <Label Text="{Binding Summary}" Style="{StaticResource Muted}" />
                <SearchBar Text="{Binding SearchText}" Placeholder="Lektion oder Wort suchen (auch Arabisch)" />
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasDue}" BackgroundColor="{DynamicResource LearningSoft}">
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ReviewDueCommand}" /></Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="Wiederholen" FontAttributes="Bold" TextColor="{DynamicResource Learning}" />
                            <Label Text="{Binding DueText}" Style="{StaticResource Muted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="›" FontSize="28" TextColor="{DynamicResource Learning}" VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.EmptyView>
            <Label Text="Keine Treffer" Style="{StaticResource Muted}" HorizontalTextAlignment="Center" Margin="32" />
        </CollectionView.EmptyView>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:LessonItem">
                <Border Style="{StaticResource Card}" Margin="16,6">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLessonTapped" />
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6">
                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="18" />
                        <Border Grid.Column="1" Style="{StaticResource Pill}" Padding="10,2"
                                BackgroundColor="{DynamicResource SurfaceAlt}">
                            <Label Text="{Binding TermCount}" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource Muted}" />
                        </Border>
                        <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Topic}" Style="{StaticResource Muted}"
                               LineBreakMode="TailTruncation" />
                        <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                            <ProgressBar Progress="{Binding Progress}" ProgressColor="{DynamicResource Known}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding ProgressText}" FontSize="12" TextColor="{DynamicResource Known}" FontAttributes="Bold" />
                            <Border Grid.Column="2" Style="{StaticResource Pill}" Padding="8,1" IsVisible="{Binding HasDue}"
                                    BackgroundColor="{DynamicResource LearningSoft}">
                                <Label Text="{Binding DueText}" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource Learning}" />
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.Footer>
            <BoxView HeightRequest="16" Color="Transparent" />
        </CollectionView.Footer>
    </CollectionView>
</ContentPage>
