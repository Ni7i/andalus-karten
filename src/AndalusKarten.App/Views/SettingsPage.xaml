<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AndalusKarten.ViewModels"
             x:Class="AndalusKarten.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Einstellungen">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="4" MaximumWidthRequest="640">

            <Label Text="LERNEN" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Abfragerichtung" FontAttributes="Bold" />
                    <Picker ItemsSource="{Binding Directions}" SelectedIndex="{Binding DirectionIndex}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Umschrift anzeigen" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding ShowTransliteration}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="VOKABELN" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding VocabularyInfo}" FontAttributes="Bold" />
                    <Label Text="{Binding SourceInfo}" Style="{StaticResource Muted}" />
                    <Button Text="Vokabeldatei importieren …" Command="{Binding ImportCommand}"
                            Style="{StaticResource SecondaryButton}" />
                    <Button Text="Mitgelieferte Liste verwenden" Command="{Binding ResetVocabularyCommand}"
                            Style="{StaticResource SecondaryButton}" IsVisible="{Binding IsImported}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="FORTSCHRITT" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <Button Text="Gesamten Fortschritt löschen" Command="{Binding ResetProgressCommand}"
                        Style="{StaticResource DangerButton}" />
            </Border>

            <Label Text="{Binding AppVersion}" Style="{StaticResource Muted}"
                   HorizontalTextAlignment="Center" Margin="0,24,0,0" />
            <Label Text="Begleiter für das Arabisch-Studium am Andalus-Institut"
                   Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
