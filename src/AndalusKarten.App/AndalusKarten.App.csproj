<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <!-- Mac Catalyst lässt sich nur auf macOS (mit Xcode) bauen. -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-maccatalyst</TargetFrameworks>
    <!-- Nur für schnelle Compile-Checks ohne Android-/Apple-SDK: dotnet build -p:CompileCheck=true -->
    <TargetFrameworks Condition="'$(CompileCheck)' == 'true'">net10.0</TargetFrameworks>
    <OutputType Condition="'$(CompileCheck)' != 'true'">Exe</OutputType>
    <RootNamespace>AndalusKarten</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

    <ApplicationTitle>Andalus Karten</ApplicationTitle>
    <ApplicationId>com.ni7i.andaluskarten</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- Android: APK statt AAB, damit die App direkt aufs Pixel installiert werden kann. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <!-- Fester Sideload-Schlüssel: jede neue APK lässt sich über die alte installieren, der Lernfortschritt bleibt. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(Configuration)' == 'Release'">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(MSBuildThisFileDirectory)..\..\build\sideload.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>andalus</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>andalus-sideload</AndroidSigningStorePass>
    <AndroidSigningKeyPass>andalus-sideload</AndroidSigningKeyPass>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0F5257" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0F5257" BaseSize="160,160" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AndalusKarten.Core\AndalusKarten.Core.csproj" />
  </ItemGroup>

</Project>
