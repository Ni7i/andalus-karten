<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:AndalusKarten.Views"
       x:Class="AndalusKarten.AppShell"
       Shell.FlyoutBehavior="Disabled">
    <TabBar>
        <ShellContent Title="Lektionen" Route="lessons"
                      ContentTemplate="{DataTemplate views:LessonsPage}" />
        <ShellContent Title="Essential" Route="essential"
                      ContentTemplate="{DataTemplate views:EssentialPage}" />
        <ShellContent Title="Einstellungen" Route="settings"
                      ContentTemplate="{DataTemplate views:SettingsPage}" />
    </TabBar>
</Shell>
